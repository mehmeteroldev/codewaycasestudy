# --- Server ---
PORT=8080
NODE_ENV=development
# Comma-separated list of origins the panel is served from. Required in production.
CORS_ORIGINS=http://localhost:5173

# --- Firebase Admin ---
# Option A: path to a service-account JSON file on disk
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
# Option B: paste the service-account JSON as a single-line string
# (recommended for Cloud Run / Render / Heroku — no file uploads needed)
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Mobile client auth ---
# Pre-shared API token that mobile clients send in the `x-api-key` header
# when calling GET /api/config. Generate a strong random string.
MOBILE_API_TOKEN=replace-with-long-random-string

# --- LLM (optional, for AI-assisted country suggestions) ---
# If omitted, the /suggest-countries endpoint returns 503.
#
# Works with any OpenAI-compatible endpoint. Defaults point at Google Gemini
# (free tier; get a key at https://aistudio.google.com/app/apikey).
#
# Examples:
#   Gemini (default):  LLM_BASE_URL unset, LLM_MODEL=gemini-2.0-flash
#   OpenAI:            LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4o-mini
#   Groq:              LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter:        LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=google/gemini-2.0-flash-exp:free
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=
